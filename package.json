{
  "name": "plotpipe",
  "version": "0.1.0",
  "description": "PlotTeaFiles short-form storytelling video pipeline CLI.",
  "type": "module",
  "bin": {
    "plotpipe": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "render:sample": "npm run build && node dist/cli.js run --script ./scripts/sample-story.json --output ./out/tornado.mp4",
    "remotion:studio": "npm run build && remotion studio dist/remotion/Root.js --props=tmp/preview/remotion-props.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.473",
    "@remotion/cli": "4.0.473",
    "@remotion/renderer": "4.0.473",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "node-fetch": "^3.3.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.473",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
