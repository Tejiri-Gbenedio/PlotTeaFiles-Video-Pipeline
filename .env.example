TTS_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TTS_INSTRUCTIONS=Narrate in a cinematic, suspenseful storytelling tone with clear pacing for short-form video.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_SCRIPT_MODEL=gpt-4o-mini

# Primary AI image generation provider for B-roll.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional OpenAI image fallback/override.
OPENAI_IMAGE_MODEL=gpt-image-1-mini

PEXELS_API_KEY=

# Optional: switch TTS_PROVIDER=elevenlabs to use these instead of OpenAI TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# PlotTeaFiles Studio web app.
# mock = UI only, local = run this machine's CLI, remote = call a worker service.
STUDIO_RUNNER_MODE=mock
RENDER_WORKER_URL=
RENDER_WORKER_TOKEN=
